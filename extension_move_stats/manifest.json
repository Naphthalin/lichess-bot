{
  "manifest_version": 3,
  "name": "Lichess Bot Verbose Move Stats Viewer",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["move_stat.js"],
      "css": ["move_stat.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
